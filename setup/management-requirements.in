# This is the input file. The pinned, hash-locked file that setup actually
# installs is setup/management-requirements.txt. After editing this file,
# regenerate it for Ubuntu 22.04's Python 3.10 with:
#
#   uv pip compile setup/management-requirements.in \
#     --python-version 3.10 --python-platform x86_64-manylinux_2_35 \
#     --generate-hashes -o setup/management-requirements.txt
